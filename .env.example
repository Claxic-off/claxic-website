# Claxic Website Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit your .env file with real credentials.

# Public URL for the Claxic Academy Course Catalogue (Google Apps Script or CSV endpoint)
VITE_COURSES_API_URL=YOUR_PUBLIC_COURSE_CATALOGUE_ENDPOINT

# Public WhatsApp number. Update to the current business number if it changes.
# Example: 9342296583 for +91 93422 96583
VITE_CLAXIC_WHATSAPP=9342296583

# Optional public form endpoint. For Cloudflare Pages, keep this as /api/contact.
VITE_FORM_ENDPOINT=/api/contact

# Server-side email config. Keep these in Cloudflare Pages / environment secrets only.
CONTACT_EMAIL_RECIPIENT=support.claxic@gmail.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
